{
  "expo": {
    "name": "GuardianSOS",
    "slug": "guardiansos",
    "scheme": "guardiansos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/appIcon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "com.guardiansos.app",
      "supportsTablet": true,
      "config": {
        "googleMapsApiKey": "AIzaSyArR8lggtsFGEz6FOyMxPB3YzshMb-3q10"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "This app uses your location to show your position on the map.",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": ["fb1114350687129940"]
          }
        ]
      }
    },
    "android": {
      "package": "com.guardiansos.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyArR8lggtsFGEz6FOyMxPB3YzshMb-3q10"
        }
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      "expo-location"
    ],
    "extra": {
      "eas": {
        "projectId": "0337eb36-100e-497b-ac1e-0c07cdd3ef0b"
      }
    }
  }
}
